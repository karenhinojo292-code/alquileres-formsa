<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="alquileres_formsa.LoginPage"
    NavigationPage.HasNavigationBar="False">

    <Grid>

        <!-- Foto de fondo -->
        <Image
    Source="imagen_fondo_login.jpg"
    Aspect="AspectFill"/>

        <!-- Overlay de color + oscurecimiento (versión más suave) -->
        <BoxView>
            <BoxView.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#801E1B4B" Offset="0"/>
                    <GradientStop Color="#664C1D95" Offset="0.45"/>
                    <GradientStop Color="#990F0C29" Offset="1"/>
                </LinearGradientBrush>
            </BoxView.Background>
        </BoxView>

        <!-- Formas decorativas flotantes -->
        <Ellipse
            WidthRequest="260"
            HeightRequest="260"
            Fill="#26F59E0B"
            HorizontalOptions="End"
            VerticalOptions="Start"
            Margin="0,-90,-100,0"/>

        <Ellipse
            WidthRequest="150"
            HeightRequest="150"
            Fill="#1FFFFFFF"
            HorizontalOptions="Start"
            VerticalOptions="Start"
            Margin="-50,160,0,0"/>

        <Ellipse
            WidthRequest="300"
            HeightRequest="300"
            Fill="#22A78BFA"
            HorizontalOptions="End"
            VerticalOptions="End"
            Margin="0,0,-130,-140"/>

        <!-- Contenido -->
        <ScrollView>
            <VerticalStackLayout
                Spacing="0"
                Padding="0,64,0,36">

                <!-- Logo con marco circular y brillo -->
                <Grid
                    WidthRequest="118"
                    HeightRequest="118"
                    HorizontalOptions="Center"
                    Margin="0,0,0,18">

                    <!-- Anillo degradado -->
                    <Ellipse
                        WidthRequest="118"
                        HeightRequest="118"
                        StrokeThickness="3">
                        <Ellipse.Stroke>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#F59E0B" Offset="0"/>
                                <GradientStop Color="#EC4899" Offset="0.5"/>
                                <GradientStop Color="#A78BFA" Offset="1"/>
                            </LinearGradientBrush>
                        </Ellipse.Stroke>
                    </Ellipse>

                    <!-- Foto de logo -->
                    <Border
                        WidthRequest="102"
                        HeightRequest="102"
                        Padding="0"
                        StrokeThickness="0"
                        HorizontalOptions="Center"
                        VerticalOptions="Center">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="51"/>
                        </Border.StrokeShape>

                        <Border.Shadow>
                            <Shadow
                                Brush="#000000"
                                Radius="18"
                                Offset="0,8"
                                Opacity="0.35"/>
                        </Border.Shadow>

                        <Image
                            Source="logon.jpg"
                            Aspect="AspectFill"/>
                    </Border>

                    <!-- Badge inferior -->
                    <Border
                        WidthRequest="30"
                        HeightRequest="30"
                        StrokeThickness="2"
                        Stroke="White"
                        HorizontalOptions="End"
                        VerticalOptions="End"
                        Margin="0,0,2,2">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="15"/>
                        </Border.StrokeShape>

                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#F59E0B" Offset="0"/>
                                <GradientStop Color="#EC4899" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>

                        <Label
                            Text="🏠"
                            FontSize="13"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"/>
                    </Border>

                </Grid>

                <Label
                    Text="ALQUILER FSA"
                    FontSize="28"
                    FontAttributes="Bold"
                    TextColor="White"
                    HorizontalOptions="Center"
                    CharacterSpacing="2"/>

                <BoxView
                    WidthRequest="46"
                    HeightRequest="3"
                    CornerRadius="2"
                    HorizontalOptions="Center"
                    Margin="0,10,0,10">
                    <BoxView.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#F59E0B" Offset="0"/>
                            <GradientStop Color="#EC4899" Offset="1"/>
                        </LinearGradientBrush>
                    </BoxView.Background>
                </BoxView>

                <Label
                    Text="Tu próximo hogar comienza aquí"
                    FontSize="14"
                    TextColor="#D8CFFB"
                    HorizontalOptions="Center"
                    Margin="0,0,0,32"/>

                 <!--Tarjeta de vidrio--> 
                <Border
                     Margin="60,0"
                     Padding="28,32"
                    BackgroundColor="#26FFFFFF"
                    Stroke="#40FFFFFF"
                    StrokeThickness="1"> 

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="30"/>
                    </Border.StrokeShape>

                    <Border.Shadow>
                        <Shadow
                            Brush="#000000"
                            Radius="35"
                            Offset="0,18"
                            Opacity="0.3"/>
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="20">

                        <VerticalStackLayout Spacing="2">
                            <Label
                                Text="Iniciar sesión"
                                FontSize="24"
                                FontAttributes="Bold"
                                TextColor="White"/>
                            <Label
                                Text="Ingresá tus datos para continuar"
                                FontSize="13"
                                TextColor="#D8CFFB"/>
                        </VerticalStackLayout>

                        <!-- Correo -->
                        <VerticalStackLayout Spacing="8">
                            <Label
                                Text="CORREO ELECTRÓNICO"
                                FontSize="11"
                                FontAttributes="Bold"
                                CharacterSpacing="1"
                                TextColor="#D8CFFB"/>

                            <Grid ColumnDefinitions="30,*">
                                <Label
                                    Text="✉"
                                    FontSize="18"
                                    TextColor="#F59E0B"
                                    VerticalOptions="Center"/>

                                <Entry
                                    Grid.Column="1"
                                    x:Name="txtCorreo"
                                    Placeholder="usuario@email.com"
                                    PlaceholderColor="#B9ACEB"
                                    TextColor="White"
                                    BackgroundColor="Transparent"/>
                            </Grid>

                            <BoxView
                                HeightRequest="1"
                                BackgroundColor="#40FFFFFF"/>
                        </VerticalStackLayout>

                        <!-- Contraseña -->
                        <VerticalStackLayout Spacing="8">
                            <Label
                                Text="CONTRASEÑA"
                                FontSize="11"
                                FontAttributes="Bold"
                                CharacterSpacing="1"
                                TextColor="#D8CFFB"/>

                            <Grid ColumnDefinitions="30,*,30">
                                <Label
                                    Text="🔒"
                                    FontSize="18"
                                    TextColor="#F59E0B"
                                    VerticalOptions="Center"/>

                                <Entry
                                    Grid.Column="1"
                                    x:Name="txtPassword"
                                    Placeholder="••••••••"
                                    IsPassword="True"
                                    PlaceholderColor="#B9ACEB"
                                    TextColor="White"
                                    BackgroundColor="Transparent"/>

                                <Label
                                    x:Name="ojito"
                                        Grid.Column="2"
                                           Text="👁"
                                           FontSize="16"
                                          TextColor="#D8CFFB"
                                        VerticalOptions="Center"
                                      HorizontalOptions="Center">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="IconOjo_Tapped"/>
                                    </Label.GestureRecognizers>
                                </Label>







                            </Grid>

                            <BoxView
                                HeightRequest="1"
                                BackgroundColor="#40FFFFFF"/>
                        </VerticalStackLayout>

                        <Label
                            Text="¿Olvidaste tu contraseña?"
                            FontSize="12"
                            FontAttributes="Bold"
                            TextColor="#F59E0B"
                            HorizontalOptions="End"/>

                        <!-- Botón principal -->
                        <Border
                            HeightRequest="56"
                            StrokeThickness="0">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="28"/>
                            </Border.StrokeShape>

                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#F59E0B" Offset="0"/>
                                    <GradientStop Color="#EC4899" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>

                            <Border.Shadow>
                                <Shadow
                                    Brush="#F59E0B"
                                    Radius="22"
                                    Offset="0,10"
                                    Opacity="0.45"/>
                            </Border.Shadow>

                            <Button
                                x:Name="btnLogin"
                                Text="INICIAR SESIÓN  →"
                                FontSize="15"
                                FontAttributes="Bold"
                                TextColor="White"
                                BackgroundColor="Transparent"
                                Clicked="BtnLogin_Clicked"/>
                        </Border>

                        <!-- Separador -->
                        <Grid ColumnDefinitions="*,Auto,*" Margin="0,4">
                            <BoxView HeightRequest="1" BackgroundColor="#33FFFFFF" VerticalOptions="Center"/>
                            <Label
                                Grid.Column="1"
                                Text="o continuá con"
                                FontSize="12"
                                Margin="12,0"
                                TextColor="#B9ACEB"/>
                            <BoxView Grid.Column="2" HeightRequest="1" BackgroundColor="#33FFFFFF" VerticalOptions="Center"/>
                        </Grid>

                        <!-- Redes sociales -->
                       

                    </VerticalStackLayout>

                </Border>

                <!-- Registro -->
                <HorizontalStackLayout
                    HorizontalOptions="Center"
                    Margin="0,28,0,0"
                    Spacing="5">

                    <Label
                        Text="¿No tenés cuenta?"
                        TextColor="#D8CFFB"/>

                    <Label
                        Text="Registrate"
                        FontAttributes="Bold"
                        TextColor="#F59E0B"/>

                </HorizontalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>
