<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="alquileres_formsa.PropiedadesPage"
    Title="Resultados">

    <CollectionView x:Name="listaResultados" Margin="15">
        <CollectionView.ItemTemplate>
            <DataTemplate>
                <Border
                    Margin="0,0,0,15"
                    BackgroundColor="White"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 16"
                    Padding="15">

                    <VerticalStackLayout Spacing="6">
                        <Label
                            Text="{Binding Titulo}"
                            FontSize="18"
                            FontAttributes="Bold"
                            TextColor="#1C2541"/>

                        <Label
                            Text="{Binding Ubicacion}"
                            FontSize="13"
                            TextColor="#737B91"/>

                        <Label
                            Text="{Binding Precio}"
                            FontSize="16"
                            FontAttributes="Bold"
                            TextColor="#173B8F"/>
                    </VerticalStackLayout>

                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>

</ContentPage>